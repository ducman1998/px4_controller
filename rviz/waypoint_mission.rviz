Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Local Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 12
      Reference Frame: waypoint_mission_center
    - Class: rviz/Pose
      Name: Drone Origin Frame
      Enabled: true
      Topic: /waypoint_mission/local_pose
      Shape: Axes
      Axes Length: 0.35
      Axes Radius: 0.025
    - Class: rviz/MarkerArray
      Name: Drone and Waypoints
      Enabled: true
      Marker Topic: /waypoint_mission/markers
      Queue Size: 10
    - Class: rviz/Path
      Name: Drone Trajectory
      Enabled: true
      Topic: /waypoint_mission/trajectory
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 9
      Focal Point: {X: 0, Y: 0, Z: 0}
      Name: Current View
      Pitch: 1.4
      Target Frame: waypoint_mission_center
      Yaw: 0.785398
Window Geometry:
  Height: 846
  Width: 1200
  X: 60
  Y: 60
