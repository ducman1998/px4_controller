Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Local Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 12
      Reference Frame: waypoint_mission_center
    - Class: rviz_default_plugins/Pose
      Name: Drone Origin Frame
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /waypoint_mission/local_pose
      Shape: Axes
      Axes Length: 0.35
      Axes Radius: 0.025
    - Class: rviz_default_plugins/MarkerArray
      Name: Drone and Waypoints
      Enabled: true
      Namespaces:
        drone: true
        home_frame: true
        status: true
        waypoints: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /waypoint_mission/markers
    - Class: rviz_default_plugins/Path
      Name: Drone Trajectory
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /waypoint_mission/trajectory
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Focal Point: {X: 0, Y: 0, Z: 0}
      Name: Current View
      Pitch: 1.4
      Target Frame: waypoint_mission_center
      Yaw: 0.785398
Window Geometry:
  Height: 846
  Width: 1200
  X: 60
  Y: 60
